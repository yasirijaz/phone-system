{
  "name": "voice",
  "productName": "Voice",
  "version": "0.4.6",
  "private": true,
  "main": "main/main.js",
  "author": "Yasir",
  "license": "MIT",
  "description": "A phone sytem for everyday use",
  "type": "module",
  "scripts": {
    "build:electron": "set ELECTRON_BUILD=true && next build",
    "electron": "electron .",
    "electron-dev": "NODE_ENV=development electron .",
    "dist": "node -r dotenv/config ./node_modules/electron-builder/out/cli/cli.js --publish always",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "repository": "https://github.com/yasirijaz/phone-system",
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "build": {
    "appId": "com.windshieldhub.voice",
    "productName": "Voice",
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "main/**/*",
      "build/**/*",
      "!build/dev/**",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "yasirijaz",
        "repo": "phone-system",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "public/logo.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "WindshieldHub Voice",
        "schemes": [
          "windshieldhub-voice"
        ]
      }
    ]
  },
  "dependencies": {
    "@genkit-ai/ai": "^1.37.0",
    "@genkit-ai/core": "^1.37.0",
    "@genkit-ai/google-genai": "^1.37.0",
    "@genkit-ai/next": "^1.37.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-menubar": "^1.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@reduxjs/toolkit": "^2.12.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@twilio/voice-sdk": "^2.18.3",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.14.0",
    "framer-motion": "^12.40.0",
    "genkit": "^1.37.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "patch-package": "^8.0.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-redux": "^9.3.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "twilio-taskrouter": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/caseless": "^0.12.5",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^19",
    "app-builder-lib": "^26.15.3",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "genkit-cli": "^1.37.0",
    "postcss": "^8",
    "tailwindcss": "^4.3.1",
    "typescript": "^6"
  }
}
